import { useEffect, useState } from "react";
import Tarjeta from "../../ComponentesFormulario/Tarjeta/Tarjeta";
import Boton from "../../Boton/Boton";
import CheckBoxes from "../../CheckBoxes/CheckBoxes";
import CheckBoxes2 from "../../CheckBoxes/CheckBoxes2";
import { useForm } from "react-hook-form";
import { toast } from "sonner";
import "./ModificarPermisos.css"; // CSS para columnas

export default function ModificarPermisos({ onGuardar, id_usuario, token }) {
    const [usuario, setUsuario] = useState(null);
    const [todosLosPermisos, setTodosLosPermisos] = useState([]);
    const [permisosExtraPosibles, setPermisosExtraPosibles] = useState([]);
    const [cargando, setCargando] = useState(true);

    const { setValue, watch } = useForm();

    useEffect(() => {
        const cargarDatos = async () => {
            try {
                setCargando(true);

                // 1. Traer datos del usuario
                const resUsuario = await fetch(`${import.meta.env.VITE_API_BASE_URL}/api/usuario/${id_usuario}`);
                const dataUsuario = await resUsuario.json();
                setUsuario(dataUsuario);

                // 2. Traer todos los permisos
                const resPermisos = await fetch(`${import.meta.env.VITE_API_BASE_URL}/api/permiso`);
                const dataPermisos = await resPermisos.json();
                setTodosLosPermisos(dataPermisos);

                // 3. IDs de permisos del rol
                const idsPermisosRol = dataUsuario.permisos.map(p => p.id_permiso);

                // 4. Filtrar permisos que no están en el rol → posibles extras
                const extrasPosibles = dataPermisos.filter(
                    p => !idsPermisosRol.includes(p.id_permiso)
                );
                setPermisosExtraPosibles(extrasPosibles);

                // 5. IDs de permisos extra actuales del usuario
                const idsExtrasUsuario = dataUsuario.permisos_extra.map(p => p.id_permiso);
                setValue("permisos_extra", idsExtrasUsuario);

            } catch (error) {
                console.error("Error al cargar datos:", error);
            } finally {
                setCargando(false);
            }
        };

        if (id_usuario) cargarDatos();
    }, [id_usuario, setValue]);

    const permisosExtraSeleccionados = watch("permisos_extra") || [];

    const submit = async () => {
        console.log("Permisos extra a guardar:", permisosExtraSeleccionados);

        try {
            const response = await fetch(`${import.meta.env.VITE_API_BASE_URL}/api/usuario/${id_usuario}/permisos_extra`, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "Accept": "application/json",
                    "Authorization": `Bearer ${token}`
                },
                body: JSON.stringify({
                    permisos_extra: permisosExtraSeleccionados
                }),
            });

            if (!response.ok) {
                const errorData = await response.json();
                toast.error(errorData.error || "Error al actualizar permisos extra", { className: "__toaster_error" });
                throw new Error(errorData.error || "Error al actualizar permisos extra");
            }

            const data = await response.json();
            toast.success(data.message || "Permisos actualizados correctamente", { className: "__toaster_success" });
            onGuardar();

        } catch (error) {
            console.error("Error al modificar permisos:", error);
             toast.error("Ocurrió un error al modificar los permisos.", { className: "__toaster_error" });
        }
    };



    if (cargando) return <p>Cargando permisos...</p>;
    if (!usuario) return <p>No se encontró el usuario.</p>;

    // Función para dividir un array en subarrays de 5
    const dividirEnColumnas = (lista) => {
        const columnas = [];
        for (let i = 0; i < lista.length; i += 5) {
            columnas.push(lista.slice(i, i + 5));
        }
        return columnas;
    };

    const columnasRol = dividirEnColumnas(usuario.permisos);
    const columnasExtra = dividirEnColumnas(permisosExtraPosibles);
    console.log("Columnas Extra:", usuario.permisos_extra);
    return (
        <div className="__modificarPermisos">
            {/* Permisos del Rol */}
            <Tarjeta descripcion={`Permisos de ${usuario.apellido}, ${usuario.nombre}. Rol: ${usuario.rol[0].nombreRol}`}>
                <div className="__checkboxes_columnas">
                    {columnasRol.map((columna, i) => (
                        <div key={i} className="__columna_checkbox">
                            <CheckBoxes
                                opciones={columna.map(p => ({
                                    id: p.id_permiso,
                                    nombre: p.nombrePermiso,
                                }))}
                                valoresSeleccionados={usuario.permisos.map(p => p.id_permiso)}
                                soloLectura={true}
                            />
                        </div>
                    ))}
                </div>
            </Tarjeta>

            {columnasExtra.length !== 0 ? (
                <Tarjeta descripcion="Permisos Extra (Modificables)">
                    <div className="__checkboxes_columnas" >
                        {columnasExtra.map((columna, i) => (
                            <div key={i} className="__columna_checkbox">
                                <CheckBoxes2
                                    opciones={columna.map(p => ({
                                        id_permiso: p.id_permiso,
                                        nombre_permiso: p.nombre_permiso,
                                    }))}
                                    name="permisos_extra"
                                    valoresSeleccionados={usuario.permisos_extra.map(p => p.id_permiso)}
                                    setValue={setValue}
                                    watch={watch}
                                />
                            </div>
                        ))}
                    </div>
                </Tarjeta>) : (
                <Tarjeta descripcion={"Permisos Extra (Modificables)"}>
                    <div>No hay mas permisos extras disponibles para asignar.</div>
                </Tarjeta>)}

            <div style={{ marginTop: "1rem", display: "flex", justifyContent: "end" }}>
                <Boton
                    descripcion="Guardar"
                    habilitado={true}
                    onClick={submit}
                />
            </div>
        </div>
    );
}
